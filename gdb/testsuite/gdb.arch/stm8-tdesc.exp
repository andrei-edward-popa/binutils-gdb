# Check that STM8 target descriptions are accepted, and that target
# registers are mapped by name rather than by remote register number.

require {istarget "stm8-*-*"}
require allow_xml_test

clean_restart

proc check_stm8_register_sizes {} {
    foreach {reg size} {
	pc 4
	a  1
	x  2
	y  2
	sp 2
	cc 1
    } {
	gdb_test "p sizeof (\$$reg)" " = $size" \
	    "size of \$$reg register is $size"
    }
}

foreach filename {stm8-tdesc.xml stm8-tdesc-reordered.xml} {
    with_test_prefix $filename {
	set xml_path "$srcdir/$subdir/$filename"
	if {[is_remote host]} {
	    set xml_path [remote_download host $xml_path]
	}

	gdb_test_no_output "set tdesc filename $xml_path" \
	    "load target description"
	check_stm8_register_sizes
    }
}
